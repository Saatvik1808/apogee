{
  "name": "apogee",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "APOGEE — a real-scale rocket building and spaceflight game for the browser",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5190",
